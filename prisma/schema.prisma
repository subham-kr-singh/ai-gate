// GATE AI — Prisma schema
// Part 1 (auth + canonical syllabus) + Part 2 (question bank, test engine,
// grading) entities. Later parts (mastery, DPP, planner, AI) extend this
// file — see PROJECT_PLAN.md for the full build order.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------
// Part 1 — Auth
// ---------------------------------------------------------------------

// Single-user-oriented, but modeled as a table so the schema survives a
// future multi-user migration without a rewrite (see architecture §2).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())

  tests    Test[]
  attempts Attempt[]
  DPP      DPP[]

  @@map("users")
}

// ---------------------------------------------------------------------
// Part 1 — Canonical syllabus (versioned; see architecture §"Current
// Syllabus Is the Source of Truth" and design.md sync notes)
// ---------------------------------------------------------------------

model SyllabusVersion {
  id        String   @id @default(cuid())
  label     String // e.g. "GATE-CS-2027-v1"
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  subjects Subject[]

  @@map("syllabus_versions")
}

model Subject {
  id                String @id @default(cuid())
  syllabusVersionId String
  code              String // e.g. "DBMS", "OS" — stable short code
  name              String
  order             Int    @default(0)

  syllabusVersion SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)
  units           Unit[]
  questions       Question[]

  @@unique([syllabusVersionId, code])
  @@map("subjects")
}

model Unit {
  id        String @id @default(cuid())
  subjectId String
  name      String
  order     Int    @default(0)

  // Part 5/architecture "Maximum Unit Duration" — kept on Unit so the
  // planner has a versioned, configurable target from day one.
  targetDurationDays   Float?
  maximumExtensionDays Float?

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics    Topic[]
  questions Question[]

  @@unique([subjectId, name])
  @@map("units")
}

model Topic {
  id     String @id @default(cuid())
  unitId String
  name   String
  order  Int    @default(0)

  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  concepts  Concept[]
  questions Question[]

  @@unique([unitId, name])
  @@map("topics")
}

model Concept {
  id      String @id @default(cuid())
  topicId String
  name    String
  order   Int    @default(0)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  dependsOn    ConceptDependency[] @relation("ConceptDependent")
  dependedOnBy ConceptDependency[] @relation("ConceptPrerequisite")

  questionConcepts QuestionConcept[]

  @@unique([topicId, name])
  @@map("concepts")
}

// Prerequisite edges — see architecture §11 "Concept Dependency Graph"
model ConceptDependency {
  id             String @id @default(cuid())
  conceptId      String // the dependent concept
  prerequisiteId String // the concept that must come first

  concept      Concept @relation("ConceptDependent", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite Concept @relation("ConceptPrerequisite", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([conceptId, prerequisiteId])
  @@map("concept_dependencies")
}

// ---------------------------------------------------------------------
// Part 2 — Question bank
// ---------------------------------------------------------------------

enum QuestionType {
  MCQ
  MSQ
  NAT
}

enum QuestionStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum DifficultySource {
  MANUAL
  ESTIMATED
}

model Question {
  id        String @id @default(cuid())
  subjectId String
  unitId    String
  topicId   String

  type          QuestionType
  marks         Float
  negativeMarks Float        @default(0)

  statement     String
  // MCQ/MSQ only — null for NAT. Stored as JSON: [{ id, text }]
  options       Json?
  // MCQ: single option id. MSQ: array of option ids. NAT: numeric string.
  correctAnswer Json
  // NAT tolerance band, e.g. { min: 4.9, max: 5.1 }
  natTolerance  Json?
  solution      String?

  year      Int?
  source    String?
  sourceUrl String?
  license   String?

  difficulty        Int              @default(3) // 1 (easy) – 5 (hard)
  difficultySource  DifficultySource @default(MANUAL)
  difficultyVersion String           @default("v1")

  status      QuestionStatus @default(APPROVED)
  version     Int            @default(1)
  contentHash String         @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id])
  unit    Unit    @relation(fields: [unitId], references: [id])
  topic   Topic   @relation(fields: [topicId], references: [id])

  concepts      QuestionConcept[]
  testQuestions TestQuestion[]
  answers       Answer[]
  DPPQuestion   DPPQuestion[]

  @@index([subjectId, unitId, topicId])
  @@index([status, difficulty])
  @@map("questions")
}

model QuestionConcept {
  id         String @id @default(cuid())
  questionId String
  conceptId  String

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  concept  Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([questionId, conceptId])
  @@map("question_concepts")
}

// ---------------------------------------------------------------------
// Part 2 — Grading
// ---------------------------------------------------------------------

// One row per (examYear, questionType) marking rule. Never hard-code
// marking logic — see architecture §21 "GATE Grading Engine".
model MarkingScheme {
  id           String       @id @default(cuid())
  examYear     Int
  questionType QuestionType

  positiveMarks         Float
  // For MCQ: fraction of positiveMarks deducted on a wrong answer, e.g. 1/3.
  // For MSQ: deduction policy is partial-marking (see grading.service).
  negativeMarksFraction Float   @default(0)
  allowsPartialMarking  Boolean @default(false) // MSQ

  createdAt DateTime @default(now())

  @@unique([examYear, questionType])
  @@map("marking_schemes")
}

// ---------------------------------------------------------------------
// Part 2 — Test engine
// ---------------------------------------------------------------------

enum TestType {
  TOPIC_QUIZ
  MOCK
}

enum TestStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

model Test {
  id       String   @id @default(cuid())
  userId   String
  type     TestType
  examYear Int // which MarkingScheme year applies
  title    String

  status      TestStatus @default(IN_PROGRESS)
  startedAt   DateTime   @default(now())
  submittedAt DateTime?

  // Part 6 mock support — server-authoritative deadline.
  deadlineAt DateTime?

  totalMarks  Float?
  scoredMarks Float?
  accuracy    Float?

  // In-progress autosave state, keyed by questionId. Only the final
  // submit writes the authoritative, append-only Attempt/Answer rows —
  // this field is disposable scratch state, not historical evidence.
  // Shape: { [questionId]: { seq, selectedAnswer, confidence?,
  //   markedForReview?, timeTakenMs?, updatedAt } }
  draftAnswers Json?

  user          User           @relation(fields: [userId], references: [id])
  testQuestions TestQuestion[]
  attempts      Attempt[]

  @@index([userId, status])
  @@map("tests")
}

model TestQuestion {
  id         String @id @default(cuid())
  testId     String
  questionId String
  order      Int

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([testId, questionId])
  @@unique([testId, order])
  @@map("test_questions")
}

// One attempt = one submitted test instance. Answers are append-only
// child rows (architecture §24 "Attempt History" — never rewritten).
model Attempt {
  id     String @id @default(cuid())
  userId String
  testId String

  submittedAt DateTime @default(now())
  totalMarks  Float
  scoredMarks Float
  accuracy    Float

  user    User     @relation(fields: [userId], references: [id])
  test    Test     @relation(fields: [testId], references: [id])
  answers Answer[]

  @@map("attempts")
}

model Answer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String
  userId     String

  // Monotonically increasing per (testId, questionId) — see architecture
  // "Autosave and Phone Reliability". Guards against an older autosave
  // request overwriting a newer one on a flaky connection.
  seq Int

  selectedAnswer  Json // same shape as Question.correctAnswer
  correct         Boolean
  marks           Float
  timeTakenMs     Int?
  confidence      Int? // 1–4, optional (architecture §16)
  markedForReview Boolean @default(false)

  createdAt DateTime @default(now())

  attempt  Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("answers")
}

// ---------------------------------------------------------------------
// Part 3 — Learning State (mastery, mistakes, coverage)
// ---------------------------------------------------------------------

enum MistakeType {
  CONCEPTUAL_GAP
  CALCULATION_ERROR
  MISREAD
  FORMULA_RECALL
  CONFUSED_CONCEPTS
  CARELESS_ERROR
  GUESS
  TIME_PRESSURE
}

enum ClassificationSource {
  USER
  AI
}

enum CoverageStatus {
  NOT_STARTED
  LEARNING
  PRACTICING
  PROVISIONALLY_COMPLETE
  MASTERED
  REVISION_DUE
}

/// One row per wrong graded answer. mistakeType is null until the student
/// tags it (one tap). answerId is Part 2's Answer.id and makes creation idempotent.
model Mistake {
  id                       String                @id @default(cuid())
  userId                   String
  answerId                 String?
  questionId               String?
  unitId                   String?
  topicId                  String?
  mistakeType              MistakeType?
  classificationSource     ClassificationSource?
  classificationConfidence Float?
  note                     String?
  resolved                 Boolean               @default(false)
  resolvedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  concepts                 MistakeConcept[]

  @@unique([userId, answerId])
  @@index([userId, resolved])
  @@index([userId, unitId])
  @@index([userId, mistakeType])
  @@index([userId, questionId])
}

model MistakeConcept {
  mistakeId String
  conceptId String
  mistake   Mistake @relation(fields: [mistakeId], references: [id], onDelete: Cascade)

  @@id([mistakeId, conceptId])
  @@index([conceptId])
}

/// Evidence-based state per concept. Raw attempts stay in Part 2 (append-only);
/// this is derived and can be rebuilt.
model ConceptStats {
  id               String    @id @default(cuid())
  userId           String
  conceptId        String
  completion       Float     @default(0)
  mastery          Float?
  retention        Float?
  confidence       Float?
  recentAccuracy   Float?
  attempts         Int       @default(0)
  correct          Int       @default(0)
  mistakes         Int       @default(0)
  averageTimeMs    Float?
  lastSeen         DateTime?
    nextReviewAt     DateTime?
  pyqAttempts      Int       @default(0)
  pyqCorrect       Int       @default(0)
  algorithmVersion String    @default("v1")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, conceptId])
  @@index([userId, mastery])
}

model TopicStats {
  id               String    @id @default(cuid())
  userId           String
  topicId          String
  completion       Float     @default(0)
  mastery          Float?
  retention        Float?
  confidence       Float?
  recentAccuracy   Float?
  attempts         Int       @default(0)
  correct          Int       @default(0)
  mistakes         Int       @default(0)
  averageTimeMs    Float?
  lastSeen         DateTime?
    nextReviewAt     DateTime?
  pyqAttempts      Int       @default(0)
  pyqCorrect       Int       @default(0)
  algorithmVersion String    @default("v1")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, topicId])
  @@index([userId, mastery])
}

/// Unit-level, evidence-validated state (what the data says), separate from
/// StudentCoverage (what the student says they covered).
model LearningState {
  id                  String         @id @default(cuid())
  userId              String
  unitId              String
  status              CoverageStatus @default(NOT_STARTED)
  coverage            Float          @default(0)
  mastery             Float          @default(0)
  practiceAccuracy    Float?
  pyqAccuracy         Float?
  evidence            Float          @default(0)
  openMistakes        Int            @default(0)
  readiness           Float?
  decision            String         @default("CONTINUE")
  reasons             Json           @default("[]")
  // Cumulative self-reported questions from Quick Study Reports.
  reportedAttempts    Int            @default(0)
  reportedCorrect     Int            @default(0)
  reportedPyqAttempts Int            @default(0)
  reportedPyqCorrect  Int            @default(0)
  userWantsToContinue Boolean        @default(false)
  completionVersion   String         @default("v1")
  masteryVersion      String         @default("v1")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([userId, unitId])
  @@index([userId, status])
}

/// What the student reports having covered. Never proof of mastery.
model StudentCoverage {
  id              String         @id @default(cuid())
  userId          String
  unitId          String
  reportedStatus  CoverageStatus
  reportedPercent Float?
  updatedAt       DateTime       @updatedAt

  @@unique([userId, unitId])
}

/// Personal preferences. Soft targets only - Part 5 reads these.
model StudentPlan {
  id                String   @id @default(cuid())
  userId            String   @unique
  targetUnitsPerDay Float    @default(1)
  maxExtensionDays  Int      @default(2)
  fixedTimeSlots    Boolean  @default(false)
  notes             String?
  updatedAt         DateTime @updatedAt
}

/// Pre-FSRS interval ladder per concept. Part 5 adds FSRS columns for flashcards.
model ReviewState {
  id             String    @id @default(cuid())
  userId         String
  conceptId      String
  stage          Int       @default(0)
  lapses         Int       @default(0)
  dueAt          DateTime
  lastReviewedAt DateTime?
  ladderVersion  String    @default("v1")
  updatedAt      DateTime  @updatedAt

  @@unique([userId, conceptId])
  @@index([userId, dueAt])
}

model StudySession {
  id        String              @id @default(cuid())
  userId    String
  unitId    String?
  source    String              @default("MANUAL")
  startedAt DateTime            @default(now())
  report    StudySessionReport?

  @@index([userId, startedAt])
}

model StudySessionReport {
  id                 String         @id @default(cuid())
  sessionId          String         @unique
  session            StudySession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId             String
  clientRequestId    String
  unitId             String
  status             CoverageStatus
  topicsCoveredIds   String[]
  weakTopicIds       String[]
  questionsAttempted Int            @default(0)
  questionsCorrect   Int            @default(0)
  pyqAttempted       Int            @default(0)
  pyqCorrect         Int            @default(0)
  selfConfidence     Int?
  continueUnit       Boolean        @default(false)
  notes              String?
  createdAt          DateTime       @default(now())

  @@unique([userId, clientRequestId])
  @@index([userId, unitId, createdAt])
}

/// Guards recordAnswers() against double-counting an Answer on retries.
model AppliedOutcome {
  answerId         String   @id
  userId           String
  algorithmVersion String
  appliedAt        DateTime @default(now())

  @@index([userId])
}

/// Raw event log (QUESTION_VIEWED, TOPIC_STUDIED, MISTAKE_CREATED, ...).
/// Keep payloads small; prune old rows per the retention policy.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, type, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// Part 4 additions — DPP Engine
//
// Append these models/enums to prisma/schema.prisma (the single schema
// file used by every part — see PROJECT_PLAN.md). They assume the
// following models already exist from Parts 1–3:
//   User        (server/auth)
//   Question    (server/domains/questions)
//   Concept     (server/domains/syllabus)
//
// After merging, run:
//   npx prisma migrate dev --name part4_dpp_engine
// ─────────────────────────────────────────────────────────────────────────

/// Where a DPP question came from. Mirrors dpp.config.ts's DPPSource union —
/// keep these in sync if either changes.
enum DPPSourceType {
  WEAK // low-mastery concept, not yet revision-due
  PREREQUISITE // supports a weak downstream concept
  REVISION // ReviewState says due today (or within the lookahead window)
  MISTAKE // concept tied to a recent logged mistake
  PYQ // previous-year question, mixed-source fill
  MIXED // general practice / backfill when a bucket runs short
}

/// One calendar day's Daily Practice Problem set for one user.
/// Generation is idempotent per (userId, date) — see dpp.service.ts.
model DPP {
  id               String   @id @default(cuid())
  userId           String
  date             DateTime @db.Date
  algorithmVersion String // e.g. "v1" — see dpp.config.ts
  targetCount      Int
  generatedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions DPPQuestion[]

  @@unique([userId, date], name: "userId_date")
  @@index([userId, date])
}

/// A single question slotted into a DPP, tagged with the candidate source
/// that selected it (so the "why is this here" UI and analytics can
/// explain the set without re-deriving it).
model DPPQuestion {
  id         String        @id @default(cuid())
  dppId      String
  questionId String
  source     DPPSourceType
  position   Int // 1-based order within the DPP
  conceptId  String? // the concept this slot targets, if applicable

  completedAt DateTime?
  correct     Boolean?

  createdAt DateTime @default(now())

  dpp      DPP      @relation(fields: [dppId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])

  @@unique([dppId, questionId])
  @@index([dppId, position])
  @@index([questionId])
}

// ─────────────────────────────────────────────────────────────────────────
// Add the reverse relations to existing models, e.g.:
//
//   model User {
//     // ...existing fields
//     dpps DPP[]
//   }
//
//   model Question {
//     // ...existing fields
//     dppQuestions DPPQuestion[]
//   }
// ─────────────────────────────────────────────────────────────────────────
// ---------------------------------------------------------------------------
// Part 5 additions — append everything below to prisma/schema.prisma, then:
//   npx prisma migrate dev --name part5_planner
//
// userId / unitId / conceptId are plain strings on purpose: the models append
// cleanly without editing User, Unit or Concept. Add @relation lines later if
// you want database-level foreign keys.
// ---------------------------------------------------------------------------

enum PlanItemStatus {
  PENDING
  ACTIVE
  PROVISIONALLY_COMPLETE
  GOOD_ENOUGH
  MOVED_ON
  MASTERED
}

enum DifficultyClass {
  EASY
  MEDIUM
  HARD
}

enum OverrideChoice {
  FOLLOW
  OVERRIDE
  SKIP
  SNOOZE
}

enum SnapshotKind {
  DAILY
  WEEKLY
}

/// One row per student: exam date, phases and soft pace targets.
model StudyPlan {
  id                String     @id @default(cuid())
  userId            String     @unique
  examDate          DateTime?  @db.Date
  prepStartDate     DateTime   @db.Date
  timezone          String     @default("Asia/Kolkata")
  /// Soft target ("roughly a unit a day"). Never a deadline.
  targetDaysPerUnit Float      @default(1)
  maxExtensionDays  Float      @default(2)
  /// Optional ["YYYY-MM-DD" x3]: explicit start dates of phases 2, 3 and 4.
  phaseStarts       Json?
  lastMockAt        DateTime?
  mocksCompleted    Int        @default(0)
  plannerVersion    String     @default("planner-v1")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  items             PlanItem[]
}

/// Master Plan: one row per unit, in syllabus order. Planned vs actual lives here.
model PlanItem {
  id               String          @id @default(cuid())
  planId           String
  plan             StudyPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId           String
  unitId           String
  sequence         Int
  status           PlanItemStatus  @default(PENDING)
  difficultyClass  DifficultyClass @default(MEDIUM)
  targetDays       Float           @default(1)
  maxExtensionDays Float           @default(2)
  startedAt        DateTime?
  completedAt      DateTime?
  actualDays       Float?
  exitReason       String?
  /// { conceptIds: string[], readiness: number | null } left unresolved when the unit closed.
  unresolved       Json?
  snoozedUntil     DateTime?
  revisionCount    Int             @default(0)
  lastRevisedAt    DateTime?
  nextRevisionAt   DateTime?
  plannerVersion   String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([userId, unitId])
  @@index([userId, status])
}

/// What the planner recommended, why, and the state it started from.
model PlannerDecision {
  id              String         @id @default(cuid())
  userId          String
  forDate         DateTime       @db.Date
  action          String
  targetType      String
  unitId          String?
  conceptId       String?
  priority        Float
  reasons         Json
  steps           Json
  alternatives    Json
  phase           Int
  inputHash       String
  priorityVersion String
  plannerVersion  String
  /// Snapshot of the target unit before the intervention (architecture section 4.4).
  beforeState     Json?
  /// Filled later from fresh questions, PYQs or mocks, never from the mastery number itself.
  outcome         Json?
  evaluatedAt     DateTime?
  createdAt       DateTime       @default(now())
  overrides       UserOverride[]

  @@unique([userId, forDate, inputHash])
  @@index([userId, forDate])
}

/// Explicit student decisions that differ from, or respond to, a recommendation.
model UserOverride {
  id                 String          @id @default(cuid())
  userId             String
  forDate            DateTime        @db.Date
  decisionId         String?
  decision           PlannerDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)
  choice             OverrideChoice
  recommendedAction  String?
  recommendedUnitId  String?
  chosenUnitId       String?
  reason             String?
  snoozedUntil       DateTime?
  /// Weak concepts that stay owed for revision after the student moved on.
  unresolvedSnapshot Json?
  createdAt          DateTime        @default(now())

  @@index([userId, forDate])
}

/// Flashcards scheduled by ts-fsrs. Columns mirror the ts-fsrs Card.
model Flashcard {
  id            String            @id @default(cuid())
  userId        String
  conceptId     String?
  unitId        String?
  kind          String            @default("DEFINITION")
  front         String
  back          String
  suspended     Boolean           @default(false)
  state         Int               @default(0)
  due           DateTime
  stability     Float             @default(0)
  difficulty    Float             @default(0)
  elapsedDays   Int               @default(0)
  scheduledDays Int               @default(0)
  learningSteps Int               @default(0)
  reps          Int               @default(0)
  lapses        Int               @default(0)
  lastReview    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  reviews       FlashcardReview[]

  @@index([userId, due])
  @@index([userId, conceptId])
}

/// Append-only review history. Never rewritten when the scheduler changes.
model FlashcardReview {
  id            String    @id @default(cuid())
  flashcardId   String
  flashcard     Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  userId        String
  rating        Int
  stateBefore   Int
  dueBefore     DateTime
  stability     Float
  difficulty    Float
  scheduledDays Int
  reviewedAt    DateTime

  @@index([userId, reviewedAt])
}

/// Daily and weekly progress snapshots (pace history, weekly comparison).
model PlanSnapshot {
  id         String       @id @default(cuid())
  userId     String
  kind       SnapshotKind
  capturedOn DateTime     @db.Date
  phase      Int
  daysToExam Int?
  metrics    Json
  report     Json?
  createdAt  DateTime     @default(now())

  @@unique([userId, kind, capturedOn])
  @@index([userId, kind, capturedOn])
}
// ─────────────────────────────────────────────────────────────────────────────
// Part 6 — Mock Simulator: schema additions
//
// HOW TO APPLY
//   1. Paste everything below into prisma/schema.prisma (after the Part 5 models).
//   2. npx prisma migrate dev --name part6_mock_simulator
//
// DESIGN NOTES
//   • These models are deliberately relation-free with respect to Parts 1–5
//     (userId / questionId are plain strings), so Part 6 never forces an edit to
//     User, Question, Test or Attempt. Add @relation + back-relations if you
//     want DB-level foreign keys.
//   • MockTest is the "Test subtype" from PROJECT_PLAN.md: it owns the clock
//     (startedAt / deadlineAt). The browser never does.
//   • MockAnswerEvent is append-only (architecture §24 / §74). MockAnswerState
//     is the materialised "current answer" derived from it.
//   • Table names are Prisma defaults ("MockTest" …). mock.repository.ts uses one
//     raw query (SELECT … FOR UPDATE) that quotes "MockTest" — if you add @@map,
//     update that query.
// ─────────────────────────────────────────────────────────────────────────────

enum MockStatus {
  READY        // paper assembled, clock NOT started
  IN_PROGRESS  // clock running on the server
  SUBMITTED    // graded, result stored
}

enum MockSubmitReason {
  USER            // student pressed Submit
  TIMER           // client saw deadlineAt pass and submitted
  EXPIRED_SERVER  // nobody came back; server finalised after the late-sync window
}

enum MockEventKind {
  SELECT
  CLEAR
  MARK
  UNMARK
  GUESS
  UNGUESS
  VISIT  // question opened
  LEAVE  // student navigated away from a question (captures the first answer)
  TIME   // time banked without leaving (tab hidden)
}

model MockTest {
  id                String            @id @default(cuid())
  userId            String
  title             String
  blueprintKey      String            // e.g. "gate-2027-cs"
  examYear          Int
  syllabusVersionId String?           // syllabus version active when the paper was built
  status            MockStatus        @default(READY)

  // ── clock (server-authoritative) ──
  durationSec       Int
  startedAt         DateTime?
  deadlineAt        DateTime?         // startedAt + durationSec. remaining = deadlineAt - now.
  submittedAt       DateTime?
  submitReason      MockSubmitReason?

  // ── autosave ──
  lastSeq           Int               @default(0)   // highest accepted event seq

  // ── assembly provenance (algorithms are versioned, architecture §75) ──
  assemblySeed      String
  assemblyVersion   String
  questionCount     Int
  maxMarks          Float
  freshCount        Int               @default(0)   // questions the student had never seen

  // ── result ──
  score             Float?
  resultJson        Json?             // MockAnalytics snapshot (immutable once written)
  analyticsVersion  String?

  // ── learning-state hand-off: idempotent + retryable ──
  learningClaimedAt DateTime?
  learningAppliedAt DateTime?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items             MockPaperItem[]
  states            MockAnswerState[]
  events            MockAnswerEvent[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status, deadlineAt])
  @@index([status, learningAppliedAt])
}

model MockPaperItem {
  mockId        String
  position      Int       // 1-based order in the paper (GA first, then CS)
  questionId    String
  section       String    // "GA" | "CORE"
  marks         Int       // 1 | 2
  type          String    // "MCQ" | "MSQ" | "NAT"
  wasSeenBefore Boolean   @default(false)

  mock          MockTest  @relation(fields: [mockId], references: [id], onDelete: Cascade)

  @@id([mockId, position])
  @@unique([mockId, questionId])
}

model MockAnswerState {
  mockId          String
  questionId      String
  selected        Json?     // MCQ: "B" · MSQ: ["A","C"] · NAT: "12.5" · null = unanswered
  firstAnswer     Json?     // answer committed the first time the student left the question
  markedForReview Boolean   @default(false)
  guessed         Boolean   @default(false)
  visitCount      Int       @default(0)
  spentMs         Int       @default(0)
  lastSeq         Int       @default(0)   // seq guard: an older event never overwrites a newer one
  updatedAt       DateTime  @updatedAt

  mock            MockTest  @relation(fields: [mockId], references: [id], onDelete: Cascade)

  @@id([mockId, questionId])
}

model MockAnswerEvent {
  mockId     String
  seq        Int
  questionId String
  kind       MockEventKind
  selected   Json?
  spentMs    Int       @default(0)
  clientAt   DateTime  // client's estimate of SERVER time when it happened
  receivedAt DateTime  @default(now())
  applied    Boolean   @default(true)   // false = logged but superseded by a newer seq

  mock       MockTest  @relation(fields: [mockId], references: [id], onDelete: Cascade)

  @@id([mockId, seq])
  @@index([mockId, questionId])
}
// prisma/schema-additions-part7.prisma
//
// Merge these models into the main prisma/schema.prisma written in
// Part 1. Kept as a separate reference file here so Part 7 doesn't
// require rewriting the whole schema — copy/paste these blocks in.
//
// Swaps the in-memory stores in budget-guard.ts and
// explanation.service.ts for real persistence once applied.

model AIUsageLog {
  id                 String   @id @default(cuid())
  userId             String
  provider           String
  model              String
  purpose            String   // study_report_extraction | mistake_classification | explanation | hint | eval
  requestCount       Int      @default(1)
  inputTokens        Int?
  outputTokens       Int?
  estimatedCostCents Float?
  cacheHit           Boolean  @default(false)
  date               String   // YYYY-MM-DD, indexed for daily-cap queries
  createdAt          DateTime @default(now())

  @@index([userId, date])
}

model AIInteraction {
  id            String   @id @default(cuid())
  userId        String
  kind          String   // chat_message | mistake_suggestion | hint_request
  input         String   @db.Text
  outputRaw     String?  @db.Text
  validated     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// Cache for explanation.service.ts — keyed on questionId + the mastery/
// content version so a later content edit invalidates stale explanations.
model AIOutput {
  id             String   @id @default(cuid())
  questionId     String
  kind           String   // explanation | hint_hint_1 | hint_hint_2 | ...
  contentHash    String   // hash of (question content + trusted solution)
  output         String   @db.Text
  createdAt      DateTime @default(now())

  @@unique([questionId, kind, contentHash])
}

// Generic background-job record (Inngest event mirror), used across
// Parts 4/5/7 — included here since Phase C is the first part that
// actually needs job-level AI-cost attribution (e.g. batch explanation
// pre-generation).
model Job {
  id          String   @id @default(cuid())
  type        String
  status      String   // pending | running | succeeded | failed
  payload     Json?
  error       String?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, status])
}
