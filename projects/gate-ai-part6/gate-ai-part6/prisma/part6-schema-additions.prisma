// ─────────────────────────────────────────────────────────────────────────────
// Part 6 — Mock Simulator: schema additions
//
// HOW TO APPLY
//   1. Paste everything below into prisma/schema.prisma (after the Part 5 models).
//   2. npx prisma migrate dev --name part6_mock_simulator
//
// DESIGN NOTES
//   • These models are deliberately relation-free with respect to Parts 1–5
//     (userId / questionId are plain strings), so Part 6 never forces an edit to
//     User, Question, Test or Attempt. Add @relation + back-relations if you
//     want DB-level foreign keys.
//   • MockTest is the "Test subtype" from PROJECT_PLAN.md: it owns the clock
//     (startedAt / deadlineAt). The browser never does.
//   • MockAnswerEvent is append-only (architecture §24 / §74). MockAnswerState
//     is the materialised "current answer" derived from it.
//   • Table names are Prisma defaults ("MockTest" …). mock.repository.ts uses one
//     raw query (SELECT … FOR UPDATE) that quotes "MockTest" — if you add @@map,
//     update that query.
// ─────────────────────────────────────────────────────────────────────────────

enum MockStatus {
  READY        // paper assembled, clock NOT started
  IN_PROGRESS  // clock running on the server
  SUBMITTED    // graded, result stored
}

enum MockSubmitReason {
  USER            // student pressed Submit
  TIMER           // client saw deadlineAt pass and submitted
  EXPIRED_SERVER  // nobody came back; server finalised after the late-sync window
}

enum MockEventKind {
  SELECT
  CLEAR
  MARK
  UNMARK
  GUESS
  UNGUESS
  VISIT  // question opened
  LEAVE  // student navigated away from a question (captures the first answer)
  TIME   // time banked without leaving (tab hidden)
}

model MockTest {
  id                String            @id @default(cuid())
  userId            String
  title             String
  blueprintKey      String            // e.g. "gate-2027-cs"
  examYear          Int
  syllabusVersionId String?           // syllabus version active when the paper was built
  status            MockStatus        @default(READY)

  // ── clock (server-authoritative) ──
  durationSec       Int
  startedAt         DateTime?
  deadlineAt        DateTime?         // startedAt + durationSec. remaining = deadlineAt - now.
  submittedAt       DateTime?
  submitReason      MockSubmitReason?

  // ── autosave ──
  lastSeq           Int               @default(0)   // highest accepted event seq

  // ── assembly provenance (algorithms are versioned, architecture §75) ──
  assemblySeed      String
  assemblyVersion   String
  questionCount     Int
  maxMarks          Float
  freshCount        Int               @default(0)   // questions the student had never seen

  // ── result ──
  score             Float?
  resultJson        Json?             // MockAnalytics snapshot (immutable once written)
  analyticsVersion  String?

  // ── learning-state hand-off: idempotent + retryable ──
  learningClaimedAt DateTime?
  learningAppliedAt DateTime?

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  items             MockPaperItem[]
  states            MockAnswerState[]
  events            MockAnswerEvent[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([status, deadlineAt])
  @@index([status, learningAppliedAt])
}

model MockPaperItem {
  mockId        String
  position      Int       // 1-based order in the paper (GA first, then CS)
  questionId    String
  section       String    // "GA" | "CORE"
  marks         Int       // 1 | 2
  type          String    // "MCQ" | "MSQ" | "NAT"
  wasSeenBefore Boolean   @default(false)

  mock          MockTest  @relation(fields: [mockId], references: [id], onDelete: Cascade)

  @@id([mockId, position])
  @@unique([mockId, questionId])
}

model MockAnswerState {
  mockId          String
  questionId      String
  selected        Json?     // MCQ: "B" · MSQ: ["A","C"] · NAT: "12.5" · null = unanswered
  firstAnswer     Json?     // answer committed the first time the student left the question
  markedForReview Boolean   @default(false)
  guessed         Boolean   @default(false)
  visitCount      Int       @default(0)
  spentMs         Int       @default(0)
  lastSeq         Int       @default(0)   // seq guard: an older event never overwrites a newer one
  updatedAt       DateTime  @updatedAt

  mock            MockTest  @relation(fields: [mockId], references: [id], onDelete: Cascade)

  @@id([mockId, questionId])
}

model MockAnswerEvent {
  mockId     String
  seq        Int
  questionId String
  kind       MockEventKind
  selected   Json?
  spentMs    Int       @default(0)
  clientAt   DateTime  // client's estimate of SERVER time when it happened
  receivedAt DateTime  @default(now())
  applied    Boolean   @default(true)   // false = logged but superseded by a newer seq

  mock       MockTest  @relation(fields: [mockId], references: [id], onDelete: Cascade)

  @@id([mockId, seq])
  @@index([mockId, questionId])
}
