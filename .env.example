# Supabase transaction pooler (runtime)
DATABASE_URL="postgresql://user:pass@host:6543/postgres?pgbouncer=true"
# Supabase direct/session connection (migrations)
DIRECT_URL="postgresql://user:pass@host:5432/postgres"

AUTH_SECRET="generate-a-32-byte-random-secret"
ALLOWED_EMAILS="subham@example.com"

# Vercel Cron: a long random string. Vercel sends it as
# `Authorization: Bearer <CRON_SECRET>` to /api/cron/daily and /api/cron/weekly.
CRON_SECRET="generate-a-long-random-string"

# Phase C only — not required for Part 1/2
LLM_API_KEY=
LLM_MODEL=

NEXT_PUBLIC_APP_URL="http://localhost:3000"
