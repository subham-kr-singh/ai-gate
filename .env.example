# --- Database (Supabase Postgres, per architecture doc) ---
# Runtime connection — Supabase transaction pooler
DATABASE_URL="postgresql://postgres:[password]@[project].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Migrations — Supabase direct/session connection
DIRECT_URL="postgresql://postgres:[password]@[project].supabase.co:5432/postgres"

# --- Auth (email allowlist, Part 1) ---
# Comma-separated list of the only emails allowed to log in.
ALLOWED_EMAILS="you@example.com"
# Random secret used to sign the session cookie. Generate with:
#   openssl rand -hex 32
AUTH_SECRET=""

# --- AI (Part 7 only — not used until then) ---
LLM_API_KEY=""
LLM_MODEL=""
EMBEDDING_MODEL=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
