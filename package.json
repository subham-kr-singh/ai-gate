{
  "name": "gate-ai",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "seed": "tsx prisma/seed/index.ts",
    "ingest": "tsx --env-file=.env scripts/ingest.ts",
    "ingest:gopdfs": "tsx --env-file=.env scripts/ingest.ts --source gopdfs",
    "drafts": "tsx --env-file=.env scripts/review-drafts.ts",
    "import:questions": "tsx scripts/import-questions.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest:units": "tsx --env-file=.env scripts/ingest.ts --source gopdfs --list-units"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.58",
    "@ai-sdk/google": "^4.0.76",
    "@prisma/client": "^5.20.0",
    "@tanstack/react-query": "^5.59.0",
    "ai": "^7.0.107",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.445.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "ts-fsrs": "^5.4.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.2",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
